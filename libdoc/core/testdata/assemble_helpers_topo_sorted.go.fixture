package leaf_tc

import (
	"github.com/xhd2015/doctest/session"
	"syscall"
	"testing"
)

type Request struct{}
type Response struct{}

func callee(x int) string {
	return "x"
}
func caller(x int) string {
	return callee(x)
}

func TestGeneratedCaseLeaf(t *testing.T) {
	var sid string
	{
		s, ok := syscall.Getenv("DOCTEST_SESSION_ID")
		if !ok || s == "" {
			t.Fatalf("DOCTEST_SESSION_ID not set")
		}
		sid = s
	}
	d := &session.Doctest{
		DOCTEST_ROOT:       `{{DOCTEST_ROOT}}`,
		DOCTEST_CASE:       `{{DOCTEST_ROOT}}/leaf`,
		DOCTEST_SESSION_ID: sid,
	}
	run := func(t *testing.T, _ *session.Doctest, req *Request) (*Response, error) {
	return &Response{}, nil
}
	Run := run
	req := &Request{}
	assert := func(t *testing.T, _ *session.Doctest, req *Request, resp *Response, err error) {}
	_ = Run
	_ = caller
	_ = callee
	resp, runErr := run(t, d, req)
	assert(t, d, req, resp, runErr)
}
