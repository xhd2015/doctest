package testcase

import (
	"os"
	"path/filepath"
	"syscall"
	droot "testcase/__droot"
	registry "testcase/__registry"
	"testing"

	"github.com/xhd2015/doctest/session"
)

func init() {
	registry.Register(registry.Entry{
		Path:   "leaf",
		Labels: nil,
		Fn:     RunTestLeaf,
	})
}

func RunTestLeaf(t *testing.T) {
	var sid string
	{
		s, ok := syscall.Getenv("DOCTEST_SESSION_ID")
		if !ok || s == "" {
			t.Fatalf("DOCTEST_SESSION_ID not set")
		}
		sid = s
	}
	d := &session.Doctest{
		DOCTEST_ROOT:       `{{DOCTEST_ROOT}}`,
		DOCTEST_CASE:       `{{DOCTEST_ROOT}}/leaf`,
		DOCTEST_SESSION_ID: sid,
	}
	_, _ = os.Stat(d.DOCTEST_CASE)
	_, _ = os.Stat(filepath.Join(d.DOCTEST_CASE, "SETUP.md"))
	_, _ = os.Stat(filepath.Join(d.DOCTEST_CASE, "ASSERT.md"))
	_, _ = os.Stat(filepath.Join(d.DOCTEST_ROOT, "SETUP.md"))
	_, _ = os.Stat(filepath.Join(d.DOCTEST_ROOT, "DOCTEST.md"))
	Run := droot.Run
	req := &droot.Request{}
	setup0 := func(t *testing.T, _ *session.Doctest, req *droot.Request) error {
		_ = req
		return nil
	}
	if err := setup0(t, d, req); err != nil {
		t.Fatalf("leaf/SETUP.md failed: %v", err)
	}
	assert := func(t *testing.T, _ *session.Doctest, req *droot.Request, resp *droot.Response, err error) {
	}
	_ = Run
	// compileOnly
	_ = d
	_ = req
	_ = assert
	var resp *droot.Response
	var runErr error
	_ = resp
	_ = runErr
}
