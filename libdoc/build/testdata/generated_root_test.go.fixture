package testcase

import (
	"os"
	"path/filepath"
	"syscall"
	"testing"

	"github.com/xhd2015/doctest/session"
)

type Request struct{}
type Response struct{}

func TestGeneratedCaseRoot(t *testing.T) {
	var sid string
	{
		s, ok := syscall.Getenv("DOCTEST_SESSION_ID")
		if !ok || s == "" {
			t.Fatalf("DOCTEST_SESSION_ID not set")
		}
		sid = s
	}
	d := &session.Doctest{
		DOCTEST_ROOT:       `{{DOCTEST_ROOT}}`,
		DOCTEST_CASE:       `{{DOCTEST_ROOT}}`,
		DOCTEST_SESSION_ID: sid,
	}
	_, _ = os.Stat(d.DOCTEST_CASE)
	_, _ = os.Stat(filepath.Join(d.DOCTEST_CASE, "SETUP.md"))
	_, _ = os.Stat(filepath.Join(d.DOCTEST_CASE, "ASSERT.md"))
	_, _ = os.Stat(filepath.Join(d.DOCTEST_ROOT, "SETUP.md"))
	_, _ = os.Stat(filepath.Join(d.DOCTEST_ROOT, "DOCTEST.md"))
	run := func(t *testing.T, _ *session.Doctest, req *Request) (*Response, error) {
		return &Response{}, nil
	}
	Run := run
	req := &Request{}
	assert := func(t *testing.T, _ *session.Doctest, req *Request, resp *Response, err error) {
	}
	_ = Run
	// compileOnly
	_ = d
	_ = req
	_ = run
	_ = assert
	var resp *Response
	var runErr error
	_ = resp
	_ = runErr
}
