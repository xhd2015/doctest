package testcase

import (
	"os"
	"syscall"
	"testing"
)

var (
	DOCTEST_ROOT       string
	DOCTEST_SESSION_ID string
)

type Request struct{}
type Response struct{}

func TestGeneratedCaseRoot(t *testing.T) {
	DOCTEST_ROOT = `{{DOCTEST_ROOT}}`
	{
		sid, ok := syscall.Getenv("DOCTEST_SESSION_ID")
		if !ok || sid == "" {
			t.Fatalf("DOCTEST_SESSION_ID not set")
		}
		DOCTEST_SESSION_ID = sid
	}
	__origWd, __wdErr := os.Getwd()
	if __wdErr != nil {
		t.Fatal(__wdErr)
	}
	defer os.Chdir(__origWd)
	if err := os.Chdir(DOCTEST_ROOT); err != nil {
		t.Fatal(err)
	}

	run := func(t *testing.T, req *Request) (*Response, error) {
		return &Response{}, nil
	}
	Run := run
	req := &Request{}
	assert := func(t *testing.T, req *Request, resp *Response, err error) {
	}
	_ = Run
	// compileOnly
	_ = req
	_ = run
	_ = assert
	var resp *Response
	var runErr error
	_ = resp
	_ = runErr
}
